{
  "name": "modelpact",
  "version": "1.0.0",
  "description": "A contract for language-model backends, and the test suite that proves yours conforms to it",
  "keywords": [
    "llm",
    "ollama",
    "prompt-api",
    "contract-testing",
    "conformance",
    "adapter",
    "on-device",
    "typescript"
  ],
  "license": "MIT",
  "author": "Sergey Avdienko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvdienkoSergey/modelpact.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "patch-package",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "^26.4.1",
    "patch-package": "^8.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
