{
  "name": "modelpact",
  "version": "1.2.1",
  "description": "A contract for language-model backends, and the test suite that proves yours conforms to it",
  "keywords": [
    "llm",
    "ollama",
    "prompt-api",
    "contract-testing",
    "conformance",
    "adapter",
    "on-device",
    "typescript"
  ],
  "license": "MIT",
  "author": "Sergey Avdienko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvdienkoSergey/modelpact.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "patch-package",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p e2e --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
