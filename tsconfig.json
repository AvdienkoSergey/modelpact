{
  "compilerOptions": {
    "target": "ES2022",
    // "dom.asynciterable" is deliberately absent: it would add
    // [Symbol.asyncIterator] to ReadableStream and allow `for await` over a
    // stream, which is not portable in the browser (experimental in Safari).
    // Without it the compiler forces a reader loop.
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    // The four below are on top of the usual strict set, and the contract
    // rests on them. The first is load-bearing: without it `{ system:
    // undefined }` passes as SessionOptions and every invariant that rests on
    // an absent optional field falls apart.
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // Listed rather than auto-discovered, and down to one entry: nothing here
    // talks to the platform any more, and the one place these declarations are
    // still read is case 10 of `src/types.test-d.ts`, where the contract's
    // `DownloadMonitor` is proved to be satisfied by the browser's own
    // `CreateMonitor`. "node" is deliberately absent, so nothing in `src`
    // reaches for `process` by accident.
    "types": ["dom-chromium-ai"]
    // No "skipLibCheck": one third-party declaration file, and reading it is
    // free — a version of it that stopped compiling would be worth knowing.
  },
  "include": ["src"]
}
