{
  // The published declarations, read the way a consumer reads them: nothing
  // from `src/` on the path, `skipLibCheck` off, and no ambient types handed
  // over for free. Only `src/surface.ts`, so a third party's broken `.d.ts`
  // cannot drown out ours.
  "extends": "./tsconfig.json",
  "compilerOptions": { "skipLibCheck": false, "types": [] },
  "include": ["src/surface.ts"]
}
