{
  // No `paths` to `../../src`, on purpose. The only way in is the package's
  // `exports`, which is the whole point of writing this here.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noEmit": true,
    // On for one reason only: `@mlc-ai/web-llm` ships declarations that name
    // packages it does not depend on and a `chrome` namespace it does not
    // bring. Ours are checked without it by tsconfig.surface.json, which is
    // where the point of this directory actually lives.
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": []
  },
  "include": ["src"]
}
